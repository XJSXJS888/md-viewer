{
  "name": "md-viewer",
  "version": "1.1.0",
  "description": "轻量、专注的本地 Markdown 阅读与编辑工具",
  "author": "YG",
  "license": "MIT",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "build:renderer": "esbuild src/renderer/index.js --bundle --outfile=src/renderer/bundle.js --format=iife --platform=browser --target=chrome140 --minify",
    "start": "npm run build:renderer && electron .",
    "dev": "npm run build:renderer && electron . --dev",
    "pack:dir": "npm run build:renderer && electron-builder --win dir",
    "dist": "npm run build:renderer && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "marked": "18.1.1",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0"
  },
  "build": {
    "appId": "local.mdviewer.app",
    "productName": "MD Viewer",
    "artifactName": "MDViewer-${version}.${ext}",
    "asar": true,
    "compression": "normal",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "MDViewer-${version}.${ext}"
    }
  },
  "dependencies": {
    "iconv-lite": "0.7.3"
  }
}
